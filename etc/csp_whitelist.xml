<?xml version="1.0"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:framework:Csp/etc/csp_whitelist.xsd">
    <policies>
        <policy id="img-src">
            <values>
                <value id="applepay-img" type="host">https://applepay.cdn-apple.com</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="applepay-frame" type="host">https://applepay.cdn-apple.com</value>
            </values>
        </policy>
        <policy id="script-src">
            <values>
                <value id="applepay-script" type="host">https://applepay.cdn-apple.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>

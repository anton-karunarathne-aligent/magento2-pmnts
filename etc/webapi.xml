<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/pmnts/applepay/guest/:cartId/session" method="POST">
        <service class="PMNTS\Gateway\Api\ApplePaySessionInterface" method="requestSession"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/pmnts/applepay/customer/session" method="POST">
        <service class="PMNTS\Gateway\Api\ApplePaySessionInterface" method="requestSessionForCustomer"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
</routes>

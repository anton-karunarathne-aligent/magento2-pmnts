type StoreConfig {
    pmnts_gateway_config: PmntsGatewayConfig
    @resolver (class: "\\PMNTS\\Gateway\\Model\\Resolver\\CreatePmntsConfig")
    @doc(description:"Creates PMNTS config for initialization.")
    fatzebra_applepay_config: FatzebraApplePayConfig
    @resolver(class: "PMNTS\\Gateway\\Model\\Resolver\\Store\\ApplePayConfig")
    @doc(description: "Fat Zebra Apple Pay configuration for the store")
}

type PmntsGatewayConfig {
    allowed_card_types: [String!] @doc(description: "Return allowed card types")
    iframe_src: String @doc(description: "Fat Zebra iframe source")
    fraud_fingerprint_src: String @doc(description: "Fat Zebra iframe source for fraud fingerprint")
    is_sandbox: String @doc(description: "Indicates whether Fat Zebra is in sandbox mode")
    can_save_card: Boolean @doc(description: "Indicates whether customer can save card for future use")
    cc_vault_code: String @doc(description: "Vault code for saving card for future use")
}

input PaymentMethodInput {
    pmnts_gateway: PmntsGatewayInput
    fatzebra_applepay: FatZebraApplePayInput
    @doc(description: "Additional data required for Fat Zebra Apple Pay payments")
}

input PmntsGatewayInput {
    cc_save: Boolean @doc(description:"The is passed to save CC details for customer.")
    cc_token: String! @doc(description:"The one-time payment token generated by FatZebra gateway based on card details. Required field to make sale transaction.")
    pmnts_id: String @doc(description:"The payment id generated by FatZebra gateway based on card details. Required field to make sale transaction.")
}

type FatzebraApplePayConfig {
    supported_networks: [String] @doc(description: "Supported card types")
    merchant_country: String @doc(description: "Merchant country code")
    supported_countries: [String] @doc(description: "Supported country codes")
    is_sandbox: Boolean @doc(description: "Indicates if sandbox mode is enabled")
    store_title: String @doc(description: "Merchant display name")
    is_active: Boolean @doc(description: "Indicates if Apple Pay is active")
}

input FatZebraApplePayInput {
    applepay_wallet_payload: String
    @doc(description: "Apple Pay wallet purchase payload")
}

input RequestFatzebraApplePaySessionInput {
    cart_id: String! @doc(description: "The masked cart ID.")
    validation_url: String! @doc(description: "The validation URL provided by Apple.")
}

type RequestFatzebraApplePaySessionOutput {
    session: String!
    @doc(description: "The Apple Pay session object from Fat Zebra. Encoded as a JSON string.")
    # Apple Pay session is returned as a JSON string to accommodate the opaque nature of the Apple Pay session object.
    # I.e., it has no fixed schema is and is open to changes.
}

type Mutation {
    requestFatzebraApplePaySession(
        input: RequestFatzebraApplePaySessionInput!
    ): RequestFatzebraApplePaySessionOutput
    @resolver(class: "PMNTS\\Gateway\\Model\\Resolver\\RequestApplePaySession")
    @doc(description: "Requests an Apple Pay session from Fat Zebra.")
}
